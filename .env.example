# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Public URL of the deployed site (used for canonical URL, Open Graph, sitemap).
# Example: https://pial.netlify.app
VITE_SITE_URL=https://your-site.example.com

# Contact form endpoint (Formspree, Getform, Netlify Forms proxy, your own API...).
# Must accept a JSON POST with { name, email, subject, message }.
# Leave empty to use the mailto fallback (needs an email in src/data/site.ts).
VITE_FORM_ENDPOINT=
